{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emberyx",
  "version": "0.2.75",
  "identifier": "com.jiri.emberyx",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun run sidecar -- --copy",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Emberyx",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' data: ipc: http://ipc.localhost https://models.dev https://raw.githubusercontent.com",
        "worker-src": "'self' blob:",
        "frame-src": "http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' data: ipc: http://ipc.localhost ws://localhost:1420 https://models.dev https://raw.githubusercontent.com",
        "worker-src": "'self' blob:",
        "frame-src": "http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/emberyxd"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Jiri Machynka",
    "publisher": "Jiri Machynka",
    "shortDescription": "Desktop cockpit for coding agents",
    "longDescription": "Run Claude Code, Codex, OpenCode, and Grok across projects from one local-first chat cockpit.",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JiriMachynka/emberyx/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RDMwMzBCREM0RTg0QjEKUldTeGhFN2NDd1BUUkhmUTVDUlRSMXh3eTl6czdTWlpJOWxCaWxiZDcrRnl2VVZFNEk4emcyTEsK"
    }
  }
}
