---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Emberyx — Desktop cockpit for AI coding agents",
  description = "Run Claude Code across all your projects from one native macOS cockpit: integrated terminals, thread resume, inline git, and a live token & cost meter.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}emberyx.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}emberyx.png`, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f0906" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      const els = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
