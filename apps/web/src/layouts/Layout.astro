---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Emberyx — Desktop cockpit for AI coding agents",
  description = "Run Claude Code across all your projects from one native macOS cockpit: integrated terminals, thread resume, inline git, and a live token & cost meter.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}emberyx.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}emberyx.png`, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f0906" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      const els = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" }
      );
      els.forEach((el) => io.observe(el));

      // The hero demo leans back and settles flat while the viewport crosses
      // it. Interpolated from scroll progress, never from a scroll handler
      // per frame — one rAF callback, :custom props as the only output.
      const stage = document.querySelector<HTMLElement>(".demo-stage");
      const tilt = stage?.querySelector<HTMLElement>(".demo-tilt");
      if (stage && tilt) {
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduced) {
          let queued = false;
          const drive = () => {
            queued = false;
            // 0 while the stage's top is at the viewport's top, 1 once its
            // middle has cleared a third of the viewport — then clamped.
            const rect = stage.getBoundingClientRect();
            const progress = Math.min(
              1,
              Math.max(0, (innerHeight / 3 - rect.top) / (innerHeight / 2.5))
            );
            tilt.style.setProperty("--demo-tilt", `${(1 - progress) * 14}deg`);
            tilt.style.setProperty("--demo-lift", `${(1 - progress) * 50}`);
          };
          const request = () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(drive);
            }
          };
          drive();
          addEventListener("scroll", request, { passive: true });
          addEventListener("resize", request, { passive: true });
        }
      }
    </script>
  </body>
</html>
