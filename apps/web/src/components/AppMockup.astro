---
// Data-driven replica of the Emberyx cockpit. Edit src/data/mock.json to change
// the content — no markup changes needed. Pass a `data` prop to override.
import defaultData from "../data/mock.json";

interface Session { label: string; state: "idle" | "running"; active?: boolean }
interface Project { name: string; badge?: string; sessions: Session[] }

interface Assistant { kind: "assistant"; text: string }
interface Bullets { kind: "bullets"; items: string[] }
interface UserMsg { kind: "user"; text: string }
interface ToolCall { kind: "tool"; name: string; desc: string }
type Block = Assistant | Bullets | UserMsg | ToolCall;

interface MockData {
  projects: Project[];
  topbar: {
    project: string; branch: string; deploy: string;
    threads: string; dev: string; actions: string[];
  };
  transcript: Block[];
  composer: {
    placeholder: string; model: string;
    tokensIn: string; tokensOut: string; cost: string;
  };
}

const { data = defaultData as MockData } = Astro.props;

// Split on backticks so mock copy can carry inline code chips.
const segments = (text: string) => text.split(/(`[^`]+`)/).filter(Boolean);

const svg = (paths: string) =>
  `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const actionIcons: Record<string, string> = {
  Commands: svg('<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M14 10 9.5 14.5M14 10h-3.5M14 10v3.5"/>'),
  Files: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="m10.5 12-1.5 2 1.5 2M13.5 12l1.5 2-1.5 2"/>'),
  Changes: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M12 17v-6M9.5 13.5 12 11l2.5 2.5"/>'),
};
const actionIcon = (name: string) => actionIcons[name] ?? actionIcons.Files;
---

<div class="mockup overflow-hidden rounded-xl border border-line bg-ink">
  <div class="grid sm:grid-cols-[200px_1fr]">
    <!-- Sidebar -->
    <aside class="hidden flex-col border-r border-line-soft bg-ink-card sm:flex">
      <div class="flex items-center justify-between border-b border-line-soft px-3 py-2.5">
        <span class="flex items-center gap-2">
          <img src="/emberyx.png" alt="" width="15" height="15" class="rounded-sm" />
          <span class="text-[13px] font-semibold">Emberyx</span>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-ash-dim"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
      </div>

      <div class="flex-1 space-y-3 overflow-hidden px-2 py-3 text-[12px]">
        {data.projects.map((p, i) => (
          <div class="space-y-0.5">
            <div class:list={["flex items-center gap-2 rounded-md px-2 py-1.5", i === 0 && "border border-line bg-ink"]}>
              <span class="h-2 w-2 shrink-0 rounded-full bg-ember"></span>
              <span class="truncate font-medium">{p.name}</span>
              {p.badge && <span class="ml-auto rounded border border-line px-1 py-px text-[10px] text-ash-dim">{p.badge}</span>}
            </div>

            {p.sessions.map((s) => (
              <div class:list={["ml-2 flex items-center gap-2 rounded-md px-2 py-1.5", s.active ? "border border-line bg-ink text-white" : "text-ash"]}>
                <span class:list={["h-1.5 w-1.5 shrink-0 rounded-full", s.state === "running" ? "bg-[#28c840]" : "bg-ash-dim"]}></span>
                <span class="truncate">{s.label}</span>
              </div>
            ))}

            {i === 0 && (
              <div class="ml-2 space-y-0.5 text-ash-dim">
                <div class="flex items-center gap-2 px-2 py-1.5">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                  Agent
                </div>
                <div class="flex items-center gap-2 px-2 py-1.5">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h10M18 8h2M4 16h4M12 16h8"/><circle cx="16" cy="8" r="2"/><circle cx="10" cy="16" r="2"/></svg>
                  Settings
                </div>
              </div>
            )}
          </div>
        ))}

        <div class="flex items-center gap-2 px-2 py-1.5 text-ash-dim">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          Open project
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-line-soft px-3 py-2.5 text-[12px] text-ash-dim">
        <span class="flex items-center gap-2">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 7 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 3 15H2.9a2 2 0 1 1 0-4H3a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 9 4.6V4a2 2 0 1 1 4 0v.1A1.6 1.6 0 0 0 17 4.6a1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.6 1.6 0 0 0 21 9v.1a2 2 0 1 1 0 4z"/></svg>
          Settings
        </span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-w-0 flex-col">
      <!-- Top bar -->
      <div class="flex items-center justify-between gap-3 border-b border-line-soft px-4 py-2 text-[12px]">
        <span class="flex shrink-0 items-center gap-2 text-ash">
          {data.topbar.project}
          <span class="flex items-center gap-1 text-ash-dim">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7M18 10.5c0 4-6 2.5-6 7.5"/></svg>
            {data.topbar.branch}
          </span>
        </span>

        <div class="flex items-center gap-2 text-ash">
          <span class="hidden items-center gap-1.5 rounded-md px-2 py-1 lg:flex">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/></svg>
            {data.topbar.deploy}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </span>
          <span class="hidden h-6 w-6 items-center justify-center rounded-md text-ash-dim lg:flex">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M14.5 9.5a2.5 2.5 0 0 0-2.5-1.5c-1.4 0-2.5.8-2.5 2s1.1 1.8 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2a2.6 2.6 0 0 1-2.5-1.5"/></svg>
          </span>
          <span class="flex items-center rounded-md border border-line bg-ink-card text-white">
            <span class="flex items-center gap-1.5 py-1 pl-2 pr-2.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M7 4.5 19 12 7 19.5z"/></svg>
              {data.topbar.dev}
            </span>
            <span class="border-l border-line px-1.5 py-1 text-ash-dim">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </span>
          <span class="hidden items-center gap-1.5 rounded-md px-2 py-1 md:flex">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 8v4.5l3 1.5"/></svg>
            {data.topbar.threads}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </span>
          {data.topbar.actions.map((a) => (
            <span class="hidden items-center gap-1.5 rounded-md px-2 py-1 xl:flex">
              <Fragment set:html={actionIcon(a)} />
              {a}
            </span>
          ))}
        </div>
      </div>

      <!-- Transcript -->
      <div class="relative h-[360px] space-y-4 overflow-hidden px-5 py-5">
        {data.transcript.map((b) => (
          b.kind === "assistant" ? (
            <p class="max-w-prose text-[13px] leading-relaxed text-[#dcdce0]">
              {segments(b.text).map((s) => (
                s.startsWith("`")
                  ? <code class="rounded border border-line bg-ink-soft px-1 py-0.5 font-mono text-[11px] text-ash">{s.slice(1, -1)}</code>
                  : <Fragment>{s}</Fragment>
              ))}
            </p>
          ) : b.kind === "bullets" ? (
            <ul class="max-w-prose list-disc space-y-1 pl-5 text-[13px] leading-relaxed text-ash marker:text-ash-dim">
              {b.items.map((it) => (
                <li>
                  {segments(it).map((s) => (
                    s.startsWith("`")
                      ? <code class="rounded border border-line bg-ink-soft px-1 py-0.5 font-mono text-[11px] text-ash">{s.slice(1, -1)}</code>
                      : <Fragment>{s}</Fragment>
                  ))}
                </li>
              ))}
            </ul>
          ) : b.kind === "user" ? (
            <div class="flex justify-end">
              <span class="rounded-lg border border-line bg-ink-card px-3.5 py-2 font-mono text-[12px] text-white">{b.text}</span>
            </div>
          ) : (
            <div class="flex items-center gap-2 rounded-lg border border-line bg-ink-card px-3 py-2 text-[12px]">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-ash-dim"><path d="m4 7 5 5-5 5M12 17h8"/></svg>
              <span class="font-mono font-medium">{b.name}</span>
              <span class="truncate font-mono text-ash-dim">{b.desc}</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto shrink-0 text-[#28c840]"><path d="m20 6-11 11-5-5"/></svg>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-ash-dim"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          )
        ))}
      </div>

      <!-- Composer -->
      <div class="p-3">
        <div class="rounded-lg border border-ember/60 bg-ink-soft px-3.5 py-3">
          <p class="text-[13px] text-ash-dim">{data.composer.placeholder}</p>
          <div class="mt-4 flex items-center gap-3 text-[11px] tabular-nums text-ash">
            <span class="flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" class="text-ember"><path d="m12 3 2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/></svg>
              <span class="font-medium text-white">{data.composer.model}</span>
            </span>
            <span class="font-mono text-ash-dim">↓ {data.composer.tokensOut}</span>
            <span class="font-mono text-ash-dim">↑ {data.composer.tokensIn}</span>
            <span class="font-mono text-ember">{data.composer.cost}</span>
            <span class="ml-auto flex h-7 w-7 items-center justify-center rounded-full bg-ember text-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
