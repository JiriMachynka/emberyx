---
// Data-driven replica of the Emberyx cockpit. Edit src/data/mock.json to change
// the content — no markup changes needed. Pass a `data` prop to override.
import defaultData from "../data/mock.json";

interface Session { label: string; state: "idle" | "running"; active?: boolean }
interface Project {
  name: string; initial: string; tint: string;
  badge?: string; active?: boolean; showAgent?: boolean; sessions: Session[];
}

interface Assistant { kind: "assistant"; text: string }
interface Bullets { kind: "bullets"; items: string[] }
interface UserMsg { kind: "user"; text: string }
interface ToolCall { kind: "tool"; name: string; desc: string }
type Block = Assistant | Bullets | UserMsg | ToolCall;

interface Surface { key: string; name: string; desc: string }

interface MockData {
  search: string;
  projects: Project[];
  topbar: { project: string; branch: string };
  transcript: Block[];
  composer: {
    placeholder: string; model: string; access: string; mode: string;
    tokensIn: string; tokensOut: string; cost: string;
  };
  surfaces: Surface[];
}

const { data = defaultData as MockData } = Astro.props;

// Split on backticks so mock copy can carry inline code chips.
const segments = (text: string) => text.split(/(`[^`]+`)/).filter(Boolean);

const svg = (paths: string, opts = "") =>
  `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ${opts}>${paths}</svg>`;

const icons = {
  collapse: svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/>'),
  search: svg('<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>'),
  plus: svg('<path d="M12 5v14M5 12h14"/>'),
  menu: svg('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'),
  threads: svg('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 8v4.5l3 1.5"/>'),
  chevron: svg('<path d="m6 9 6 6 6-6"/>', 'stroke-width="2"'),
  branch: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7M18 10.5c0 4-6 2.5-6 7.5"/>'),
  dollar: svg('<circle cx="12" cy="12" r="9"/><path d="M12 7v10M14.5 9.5a2.5 2.5 0 0 0-2.5-1.5c-1.4 0-2.5.8-2.5 2s1.1 1.8 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2a2.6 2.6 0 0 1-2.5-1.5"/>'),
  play: svg('<path d="M7 4.5 19 12 7 19.5z"/>', 'fill="currentColor" stroke="none"'),
  gear: svg('<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>'),
  bell: svg('<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>'),
  lock: svg('<rect x="4" y="10.5" width="16" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'),
  hammer: svg('<path d="M15 12 6.5 20.5a2.1 2.1 0 0 1-3-3L12 9"/><path d="M17.5 2 12 7.5l4.5 4.5L22 6.5z"/>'),
  sparkle: svg('<path d="m12 3 2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/>'),
  send: svg('<path d="M12 19V5M5 12l7-7 7 7"/>', 'stroke-width="2.2"'),
  close: svg('<path d="M18 6 6 18M6 6l12 12"/>', 'stroke-width="1.8"'),
  agent: svg('<path d="M12 5v14M5 12h14"/>', 'stroke-width="1.8"'),
  toolArrow: svg('<path d="m4 7 5 5-5 5M12 17h8"/>'),
  check: svg('<path d="m20 6-11 11-5-5"/>', 'stroke-width="2"'),
  terminal: svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>'),
  files: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>'),
  diff: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v6a3 3 0 0 0 3 3h6M18 15.5v-6a3 3 0 0 0-3-3H9"/>'),
};
const surfaceIcon = (key: string) => (icons as Record<string, string>)[key] ?? icons.files;
---

<div class="mockup overflow-hidden rounded-xl border border-line bg-ink">
  <div class="grid sm:grid-cols-[210px_1fr] xl:grid-cols-[210px_1fr_288px]">
    <!-- Sidebar -->
    <aside class="hidden flex-col border-r border-line-soft bg-ink-card sm:flex">
      <div class="flex items-center justify-between px-3 py-2.5">
        <span class="flex items-center gap-2">
          <img src={`${import.meta.env.BASE_URL}emberyx.png`} alt="" width="15" height="15" class="rounded-sm" />
          <span class="font-display text-[13px] font-semibold text-fg">Emberyx</span>
        </span>
        <span class="text-ash-dim" set:html={icons.collapse} />
      </div>

      <!-- Search -->
      <div class="px-2.5 pb-2">
        <div class="flex items-center gap-2 rounded-md border border-line-soft bg-ink px-2.5 py-1.5 text-[12px] text-ash-dim">
          <Fragment set:html={icons.search} />
          <span class="flex-1">{data.search}</span>
          <span class="rounded border border-line-soft px-1 py-px font-mono text-[10px]">⌘K</span>
        </div>
      </div>

      <!-- Projects -->
      <div class="flex items-center justify-between px-3 pb-1 pt-1.5">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ash-dim">Projects</span>
        <span class="text-ash-dim" set:html={icons.plus} />
      </div>

      <div class="flex-1 space-y-1.5 overflow-hidden px-2 py-1 text-[12px]">
        {data.projects.map((p) => (
          <div class="space-y-0.5">
            <div class:list={["flex items-center gap-2 rounded-md px-2 py-1.5", p.active && "border border-line bg-ink"]}>
              <span class="grid h-5 w-5 shrink-0 place-items-center rounded-md text-[10px] font-semibold text-white" style={`background-color:${p.tint}`}>{p.initial}</span>
              <span class:list={["truncate font-medium", p.active ? "text-fg" : "text-ash"]}>{p.name}</span>
              {p.badge && <span class="ml-auto rounded border border-line px-1 py-px text-[10px] text-ash-dim">{p.badge}</span>}
            </div>

            {p.sessions.map((s) => (
              <div class:list={["ml-3.5 flex items-center gap-2 rounded-md px-2 py-1.5", s.active ? "border border-line bg-ink text-fg" : "text-ash"]}>
                <span class:list={["h-1.5 w-1.5 shrink-0 rounded-full", s.state === "running" ? "bg-signal" : "bg-ash-dim"]}></span>
                <span class="truncate">{s.label}</span>
              </div>
            ))}

            {p.showAgent && (
              <div class="ml-3.5 flex items-center gap-2 px-2 py-1.5 text-ash-dim">
                <Fragment set:html={icons.agent} />
                Agent
              </div>
            )}
          </div>
        ))}

        <div class="flex items-center gap-2 px-2 py-1.5 text-ash-dim">
          <Fragment set:html={icons.plus} />
          Open project
        </div>
      </div>

      <div class="flex items-center justify-between border-t border-line-soft px-3 py-2.5 text-[12px] text-ash-dim">
        <span class="flex items-center gap-2">
          <Fragment set:html={icons.gear} />
          Settings
        </span>
        <Fragment set:html={icons.bell} />
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-w-0 flex-col">
      <!-- Top bar -->
      <div class="flex items-center justify-between gap-3 border-b border-line-soft px-3 py-2 text-[12px]">
        <div class="flex min-w-0 items-center gap-2 text-ash">
          <span class="text-ash-dim" set:html={icons.menu} />
          <span class="flex items-center gap-1.5 rounded-md px-2 py-1">
            <Fragment set:html={icons.threads} />
            Threads
            <span class="text-ash-dim" set:html={icons.chevron} />
          </span>
          <span class="flex min-w-0 items-center gap-1.5 text-ash-dim">
            <span class="truncate text-ash">{data.topbar.project}</span>
            <Fragment set:html={icons.branch} />
            <span class="truncate">{data.topbar.branch}</span>
          </span>
        </div>

        <div class="flex shrink-0 items-center gap-1 text-ash">
          <span class="hidden h-6 w-6 items-center justify-center rounded-md text-ash-dim lg:flex" set:html={icons.dollar} />
          <span class="flex items-center rounded-md border border-line bg-ink-card text-fg">
            <span class="flex items-center gap-1.5 py-1 pl-2 pr-2.5 text-ember" set:html={icons.play + "<span class='text-fg'>Run</span>"} />
            <span class="border-l border-line px-1.5 py-1 text-ash-dim" set:html={icons.chevron} />
          </span>
          <span class="hidden h-6 w-6 items-center justify-center rounded-md text-ash-dim lg:flex" set:html={icons.collapse} />
        </div>
      </div>

      <!-- Transcript -->
      <div class="relative h-[340px] space-y-4 overflow-hidden px-5 py-5">
        {data.transcript.map((b) => (
          b.kind === "assistant" ? (
            <p class="max-w-prose text-[13px] leading-relaxed text-fg">
              {segments(b.text).map((s) => (
                s.startsWith("`")
                  ? <code class="rounded border border-line bg-ink-soft px-1 py-0.5 font-mono text-[11px] text-ash">{s.slice(1, -1)}</code>
                  : <Fragment>{s}</Fragment>
              ))}
            </p>
          ) : b.kind === "bullets" ? (
            <ul class="max-w-prose list-disc space-y-1 pl-5 text-[13px] leading-relaxed text-ash marker:text-ash-dim">
              {b.items.map((it) => (
                <li>
                  {segments(it).map((s) => (
                    s.startsWith("`")
                      ? <code class="rounded border border-line bg-ink-soft px-1 py-0.5 font-mono text-[11px] text-ash">{s.slice(1, -1)}</code>
                      : <Fragment>{s}</Fragment>
                  ))}
                </li>
              ))}
            </ul>
          ) : b.kind === "user" ? (
            <div class="flex justify-end">
              <span class="rounded-lg border border-line bg-ink-card px-3.5 py-2 font-mono text-[12px] text-fg">{b.text}</span>
            </div>
          ) : (
            <div class="flex items-center gap-2 rounded-lg border border-line bg-ink-card px-3 py-2 text-[12px]">
              <span class="shrink-0 text-ash-dim" set:html={icons.toolArrow} />
              <span class="font-mono font-medium">{b.name}</span>
              <span class="truncate font-mono text-ash-dim">{b.desc}</span>
              <span class="ml-auto shrink-0 text-signal" set:html={icons.check} />
            </div>
          )
        ))}
      </div>

      <!-- Composer -->
      <div class="p-3">
        <div class="rounded-lg border border-ember/60 bg-ink-soft px-3.5 py-3">
          <p class="text-[13px] text-ash-dim">{data.composer.placeholder}</p>
          <div class="mt-4 flex items-center gap-2.5 text-[11px] text-ash">
            <span class="flex items-center gap-1.5">
              <span class="text-ember" set:html={icons.sparkle} />
              <span class="font-medium text-fg">{data.composer.model}</span>
              <span class="text-ash-dim" set:html={icons.chevron} />
            </span>
            <span class="hidden items-center gap-1.5 text-ash-dim sm:flex">
              <Fragment set:html={icons.lock} />
              {data.composer.access}
              <Fragment set:html={icons.chevron} />
            </span>
            <span class="hidden items-center gap-1.5 text-ash-dim sm:flex">
              <Fragment set:html={icons.hammer} />
              {data.composer.mode}
              <Fragment set:html={icons.chevron} />
            </span>
            <span class="ml-auto flex items-center gap-2.5 tabular-nums">
              <span class="font-mono text-ash-dim">↓ {data.composer.tokensOut}</span>
              <span class="font-mono text-ash-dim">↑ {data.composer.tokensIn}</span>
              <span class="font-mono text-ember">{data.composer.cost}</span>
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ember text-ink" set:html={icons.send} />
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Surfaces panel -->
    <aside class="hidden flex-col border-l border-line-soft bg-ink-card xl:flex">
      <div class="flex items-center justify-between border-b border-line-soft px-3.5 py-2.5 text-[13px]">
        <span class="font-medium text-fg">Surfaces</span>
        <span class="text-ash-dim" set:html={icons.close} />
      </div>
      <div class="flex flex-1 flex-col justify-center gap-5 px-3.5 py-6">
        <div class="text-center">
          <p class="text-[13px] font-medium text-fg">Open a surface</p>
          <p class="mt-1 text-[11px] text-ash-dim">Choose what to show in the right panel.</p>
        </div>
        <div class="grid grid-cols-2 gap-2">
          {data.surfaces.map((s) => (
            <div class="card p-3">
              <span class="text-ember" set:html={surfaceIcon(s.key)} />
              <p class="mt-2 text-[12px] font-medium text-fg">{s.name}</p>
              <p class="mt-0.5 text-[10px] leading-snug text-ash-dim">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</div>
