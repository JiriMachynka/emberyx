---
// Data-driven replica of the Emberyx cockpit, 1:1 with the real app.
// Edit src/data/mock.json to change the content — no markup changes needed.
import defaultData from "../data/mock.json";

interface Topbar { project: string; title: string; editor: string; commitBadge: string }
interface ThreadGroup { project: string; time: string; title: string; branch?: string; imported?: boolean; avatar?: string; spark?: boolean; active?: boolean }
interface TranscriptBlock {
  kind: "user" | "summary" | "message" | "bullets" | "actions" | "changed";
  text?: string;
  items?: string[];
  copy?: string;
  files?: number;
  adds?: string;
  dels?: string;
  folder?: string;
  partial?: boolean;
}
interface Composer { placeholder: string; model: string; access: string; branch: string }
interface MockData {
  topbar: Topbar;
  threads: ThreadGroup[];
  settled: number;
  transcript: TranscriptBlock[];
  composer: Composer;
}

const { data = defaultData as MockData } = Astro.props;

// Split on backticks so mock copy can carry inline code chips.
const segments = (text: string) => text.split(/(`[^`]+`)/).filter(Boolean);

const svg = (paths: string, opts = "") =>
  `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ${opts}>${paths}</svg>`;

const icons = {
  pencil: svg('<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>'),
  library: svg('<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>'),
  search: svg('<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>'),
  gear: svg('<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>'),
  bell: svg('<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>'),
  chart: svg('<path d="M3 3v18h18"/><path d="M8 17v-5M13 17V7M18 17v-9"/>'),
  menu: svg('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>'),
  panel: svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/>'),
  chevron: svg('<path d="m6 9 6 6 6-6"/>', 'stroke-width="2"'),
  branch: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7M18 10.5c0 4-6 2.5-6 7.5"/>'),
  git: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v6a3 3 0 0 0 3 3h6M18 15.5v-6a3 3 0 0 0-3-3H9"/>'),
  imported: svg('<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5V20"/>'),
  sparkle: svg('<path d="m12 3 2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/>'),
  play: svg('<path d="M7 4.5 19 12 7 19.5z"/>', 'fill="currentColor" stroke="none"'),
  external: svg('<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>'),
  commit: svg('<path d="M12 19V5"/><path d="m8 11 4-4 4 4"/>', 'stroke-width="1.8"'),
  image: svg('<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>'),
  plus: svg('<path d="M12 5v14M5 12h14"/>'),
  send: svg('<path d="M12 19V5M5 12l7-7 7 7"/>', 'stroke-width="2.2"'),
  terminal: svg('<path d="m5 8 4 4-4 4"/><path d="M13 16h6"/>'),
  lock: svg('<rect x="4" y="10.5" width="16" height="9.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'),
  file: svg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>'),
  braces: svg('<path d="M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1"/>'),
  folder: svg('<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>'),
  chevronRight: svg('<path d="m9 6 6 6-6 6"/>', 'stroke-width="1.8"'),
  globe: svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18"/>'),
  pullRequest: svg('<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M6 8.5v7"/><path d="M13 6h3.5a1.5 1.5 0 0 1 1.5 1.5V15"/><path d="m15 12 2 2 2-2"/>'),
  output: svg('<path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" fill="none" opacity="0"/><path d="M12 15v4"/><path d="m9 16 3 3 3-3"/><rect x="4" y="3" width="16" height="10" rx="2"/>'),
  close: svg('<path d="M18 6 6 18M6 6l12 12"/>', 'stroke-width="1.8"'),
  review: svg('<path d="M3 13a2 2 0 0 1 2-2h2l2 2h4a2 2 0 0 0 2-2l1-1h3a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" opacity="0"/><path d="m10 8 -4 4 4 4"/><path d="M6 12h9a4 4 0 0 0 4-4"/>'),
  copy: svg('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>'),
};
---

<div class="mockup overflow-hidden rounded-xl border border-line bg-ink">
  <div class="grid sm:grid-cols-[240px_1fr] sm:grid-rows-[auto_1fr] xl:grid-cols-[240px_1fr_384px]">
    <!-- Sidebar -->
    <aside class="row-span-2 hidden flex-col border-r border-line-soft bg-ink-soft sm:flex sm:col-start-1 sm:row-start-1">
      <div class="flex items-center gap-2 px-3 py-2.5">
        <div class="flex flex-1 items-center gap-2 text-[12px] text-ash-dim">
          <Fragment set:html={icons.search} />
          <span>Search</span>
        </div>
        <span class="flex h-7 w-7 items-center justify-center rounded-md text-ash-dim" set:html={icons.pencil} />
        <span class="flex h-7 w-7 items-center justify-center rounded-md text-ash-dim" set:html={icons.library} />
      </div>

      <!-- Threads -->
      <div class="px-3.5 pb-1.5 pt-4">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ash-dim">Threads</span>
      </div>

      <div class="flex flex-1 flex-col gap-1 overflow-hidden px-2 pt-1">
        {data.threads.map((t) => (
          <div class:list={["rounded-lg border px-2.5 py-2", t.active ? "border-line bg-ink-card" : "border-line-soft bg-ink-card/40"]}>
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-ember"></span>
              <span class="truncate text-[12px] font-medium text-fg">{t.project}</span>
              <span class="ml-auto shrink-0 text-[11px] text-ash-dim">{t.time}</span>
            </div>
            <div class="mt-1.5 flex items-start gap-2">
              {t.avatar ? (
                <span class="grid h-4 w-4 shrink-0 place-items-center rounded bg-ash-dim text-[9px] font-semibold text-ink">{t.avatar}</span>
              ) : (
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ash-dim"></span>
              )}
              <span class="line-clamp-2 min-w-0 flex-1 text-[12px] font-medium leading-snug text-fg">{t.title}</span>
              <div class="mt-0.5 flex shrink-0 flex-col items-center gap-2">
                {t.imported && <span class="text-ash-dim" set:html={icons.imported} />}
                {t.spark && <span class="text-ember" set:html={icons.sparkle} />}
              </div>
            </div>
            {t.branch && (
              <div class="mt-1 flex items-center gap-1.5 pl-6 text-[11px] text-ash-dim">
                <span class="text-[9px]" set:html={icons.branch} />
                <span>{t.branch}</span>
              </div>
            )}
          </div>
        ))}

        <button class="flex w-full items-center justify-between px-2.5 py-2 text-[12px] text-ash">
          <span>Settled ({data.settled})</span>
          <span class="text-ash-dim" set:html={icons.chevron} />
        </button>
      </div>

      <div class="flex items-center gap-3 border-t border-line-soft px-3.5 py-3 text-ash-dim">
        <span class="flex h-7 w-7 items-center justify-center rounded-md" set:html={icons.gear} />
        <span class="flex h-7 w-7 items-center justify-center rounded-md" set:html={icons.chart} />
        <span class="ml-auto flex h-7 w-7 items-center justify-center rounded-md" set:html={icons.bell} />
      </div>
    </aside>

    <!-- Window top bar -->
    <div class="hidden items-center gap-2 border-b border-line-soft px-3 py-2 text-[12px] sm:flex sm:col-start-2 sm:row-start-1 xl:col-span-2">
      <div class="flex min-w-0 items-center gap-2">
        <span class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-md text-ash-dim sm:flex" set:html={icons.menu} />
        <span class="ml-1 flex min-w-0 items-center gap-1.5">
          <span class="h-2 w-2 shrink-0 rounded-full bg-ember"></span>
          <span class="shrink-0 font-medium text-fg">{data.topbar.project}</span>
          <span class="shrink-0 text-ash-dim">/</span>
          <span class="truncate text-ash">{data.topbar.title}</span>
        </span>
      </div>

      <div class="ml-auto flex shrink-0 items-center gap-1.5">
        <span class="hidden items-center gap-1.5 rounded-md border border-line bg-ink-card px-2 py-1 text-fg md:flex" set:html={icons.external + `<span>${data.topbar.editor}</span>`} />
        <span class="flex items-center rounded-md border border-line bg-ink-card">
          <span class="flex items-center gap-1.5 py-1 pl-2 pr-2" set:html={icons.play + "<span class='text-fg'>Run</span>"} />
          <span class="border-l border-line px-1 text-ash-dim" set:html={icons.chevron} />
        </span>
        <span class="hidden items-center gap-1.5 rounded-md border border-line bg-ink-card px-2 py-1 text-fg md:flex" set:html={icons.git + "<span>Git</span>"} />
        <span class="hidden items-center gap-1.5 rounded-md border border-line bg-ink-card px-2 py-1 text-fg md:flex" set:html={icons.commit + `<span>Commit &amp; push</span><span class="rounded bg-ember px-1 py-px font-mono text-[9px] text-ink">${data.topbar.commitBadge}</span><span class="text-ash-dim">${icons.chevron}</span>`} />
        <span class="hidden h-7 w-7 items-center justify-center rounded-md border border-ember bg-ink-card text-fg lg:flex" set:html={icons.panel} />
      </div>
    </div>
    <!-- Main column -->
    <div class="flex min-w-0 flex-col">
      <!-- Transcript -->
      <div class="relative flex-1 space-y-5 overflow-hidden px-6 py-5 lg:h-[520px]">
        {data.transcript.map((b) => (
          <div class:list={[b.partial && "-mt-14"]}>
            {b.kind === "user" ? (
              <div class="flex justify-end">
                <span class="rounded-lg bg-ink-card px-3.5 py-2 text-[12px] font-medium text-fg">{b.text}</span>
              </div>
            ) : b.kind === "actions" ? (
              <div class="flex items-center gap-4 text-[12px] text-ash-dim" set:html={icons.copy + `<span>${b.copy}</span>`} />
            ) : b.kind === "summary" ? (
              <p class="flex items-center gap-1 text-[12px] text-ash">
                {b.text}
                <span class="text-ash-dim" set:html={icons.chevronRight} />
              </p>
            ) : b.kind === "bullets" ? (
              <ul class="max-w-prose list-disc space-y-1.5 pl-5 text-[13px] leading-relaxed text-fg marker:text-ash-dim">
                {(b.items ?? []).map((it) => (
                  <li>
                    {segments(it).map((s) => (
                      s.startsWith("`") ? (
                        <code class="inline-flex translate-y-px items-center gap-1 rounded border border-line bg-ink-soft px-1.5 py-0.5 font-mono text-[11px] text-fg">
                          {s.startsWith("`@") && <span class="text-ash-dim" set:html={icons.file} />}
                          {s.startsWith("`{") && <span class="text-ash-dim" set:html={icons.braces} />}
                          {s.slice(1, -1).replace(/^@/, "")}
                        </code>
                      ) : <Fragment>{s}</Fragment>
                    ))}
                  </li>
                ))}
              </ul>
            ) : b.kind === "changed" ? (
              <div class="max-w-prose rounded-lg border border-line-soft bg-ink-soft">
                <div class="flex items-center gap-2 border-b border-line-soft px-3 py-2.5 text-[12px]">
                  <span class="shrink-0 text-ash-dim" set:html={icons.file} />
                  <span class="font-medium text-fg">Changed {b.files} files</span>
                  <span class="font-mono tabular-nums"><span class="text-signal">{b.adds}</span> <span class="text-danger">{b.dels}</span></span>
                  <span class="ml-auto flex items-center gap-1.5 rounded-md border border-line bg-ink-card px-2 py-1 font-medium text-fg" set:html={icons.file + "<span>Review</span>"} />
                </div>
                <div class="flex items-center gap-2 px-3 py-2 text-[12px]">
                  <span class="shrink-0 text-ash-dim" set:html={icons.chevronRight} />
                  <span class="shrink-0 text-ash-dim" set:html={icons.folder} />
                  <span class="text-fg">{b.folder}</span>
                  <span class="ml-auto font-mono tabular-nums"><span class="text-signal">{b.adds}</span> <span class="text-danger">{b.dels}</span></span>
                </div>
              </div>
            ) : (
              <p class="max-w-prose text-[13px] leading-relaxed text-fg">
                {segments(b.text ?? "").map((s) => (
                  s.startsWith("`") ? (
                    <code class:list={["inline-flex translate-y-px items-center gap-1 rounded border border-line bg-ink-soft px-1.5 py-0.5 font-mono text-[11px] text-fg", s.startsWith("`{") && "ml-1"]}>
                      {s.startsWith("`{") && <span class="text-ash-dim" set:html={icons.braces} />}
                      {s.slice(1, -1).replace(/^\{/, "")}
                    </code>
                  ) : <Fragment>{s}</Fragment>
                ))}
              </p>
            )}
          </div>
        ))}
      </div>

      <!-- Composer -->
      <div class="px-5 pb-3">
        <div class="rounded-xl border border-line bg-ink-soft px-4 py-3">
          <p class="text-[13px] text-ash-dim">{data.composer.placeholder}</p>
          <div class="mt-5 flex items-center gap-3 text-[12px]">
            <span class="flex min-w-0 items-center gap-2" set:html={icons.terminal + `<span class="truncate font-medium text-fg">${data.composer.model}</span><span class="text-ash-dim">${icons.chevron}</span>`} />
            <span class="hidden shrink-0 items-center gap-1.5 text-ash sm:flex" set:html={icons.lock + `<span>${data.composer.access}</span><span class="text-ash-dim">${icons.chevron}</span>`} />
            <span class="ml-auto flex shrink-0 items-center gap-3">
              <span class="text-ash-dim" set:html={icons.image} />
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ember text-ink" set:html={icons.send} />
            </span>
          </div>
        </div>
        <div class="mt-2.5 flex justify-center">
          <span class="flex items-center gap-1.5 rounded-lg border border-line-soft bg-ink-soft px-2 py-1 text-[11px] text-ash-dim" set:html={icons.branch + `<span>${data.composer.branch}</span>${icons.chevron}`} />
        </div>
      </div>
    </div>

    <!-- Right dock, Output surface open -->
    <aside class="hidden flex-col border-l border-line-soft bg-ink xl:flex">
      <div class="flex items-center gap-3 border-b border-line-soft px-3 py-2.5 text-[12px]">
        <span class="flex items-center rounded-md bg-ink-card px-2.5 py-1 font-medium text-fg">Output</span>
        <span class="text-ash-dim" set:html={icons.plus} />
        <span class="ml-auto text-ash-dim" set:html={icons.close} />
      </div>
      <div class="border-b border-line-soft px-4 py-2 text-[11px] text-ash-dim">
        Dev servers
      </div>
      <div class="flex-1"></div>
    </aside>
  </div>
</div>

<style>
  .mockup :global(svg) {
    display: inline-flex;
  }
</style>
