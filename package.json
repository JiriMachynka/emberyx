{
  "name": "emberyx-monorepo",
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "release": "bun scripts/release-version.ts",
    "release:check": "bun scripts/validate-release.ts",
    "desktop": "turbo run dev --filter=@emberyx/desktop",
    "web": "turbo run dev --filter=@emberyx/web",
    "tauri": "bun run --cwd apps/desktop tauri"
  },
  "type": "module",
  "workspaces": ["apps/*"]
}
